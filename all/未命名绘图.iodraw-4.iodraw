  <diagram name="第 1 页" id="fHJUZ8DEj35WRddFFpkG">
    <mxGraphModel dx="1413" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-236" value="五、网络更新与状态反馈" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="21" y="1752" width="502" height="472" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-237" value="四、采样偏差消除" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="1399" width="309" height="303" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-238" value="三、非均匀概率抽样" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="21" y="1064" width="325" height="285" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-239" value="二、双准则复合优先级评估" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="23" y="542" width="322" height="472" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-240" value="一、经验生成与特征关联" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="504" height="472" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-241" value="环境交互与元组打包&#xa;USV与潮汐环境交互，生成基础转移元组 (s_t, a_t, r_t, s_t+1)" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="178" y="45" width="259" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-242" value="风险权重附加&#xa;调用 4.2 节空间解算器，提取当前状态的实时环境风险权重 ω_risk" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="58" y="196" width="252" height="119" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-243" value="新样本初始化入池&#xa;赋予新经验当前池中最大的优先级 P_max，并存入底层 Sum-Tree 存储池" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="56" y="366" width="256" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-244" value="特征提取&#xa;当触发训练网络时，提取样本对应的时变 TD 误差 δ_i 与水位风险权重 ω_risk,i" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="58" y="567" width="252" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-245" value="复合优先级解算&#xa;通过幂函数深度耦合时间学习难度与空间高危特征:&#xa;P_i = (|δ_i| + ε)^α × (ω_risk,i)^β" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="58" y="718" width="252" height="119" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-246" value="Sum-Tree 根节点维护&#xa;更新并保存当前经验池内所有样本的累积优先级总和 Σ P_j" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="58" y="888" width="252" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-247" value="概率分布映射&#xa;构建各个样本的归一化定向采样概率: P(i) = P_i / Σ P_j" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="56" y="1089" width="255" height="84" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-248" value="Sum-Tree 分段检索&#xa;将总优先级区间划分等长段，通过线段树检索抽取小批量 (Mini-batch) 样本" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="58" y="1223" width="252" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-249" value="重要性采样权重 (IS Weights) 解算&#xa;w_i = (N × P(i))^-β_per / max(w)" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="1424" width="238" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-250" value="损失函数加权重构&#xa;将 w_i 作为权重系数乘入 Critic 网络的均方误差 (MSE) 损失中" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="65" y="1576" width="239" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-251" value="梯度反向传播&#xa;执行 Adam 优化器，利用加权梯度平滑更新 Actor 与 Critic 的网络参数" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="58" y="1777" width="252" height="119" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-252" value="实时 TD 误差重算&#xa;利用更新后的 Critic 网络，重新计算该小批量样本的新时序差分误差 δ_new" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="56" y="1946" width="256" height="101" as="geometry" />
        </mxCell>
        <mxCell id="rIZo4BDsVDI8mWQsIFSh-253" value="优先级动态回传&#xa;将 δ_new 传回 Sum-Tree，更新对应叶子节点的优先级，完成闭环" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="181" y="2098" width="255" height="101" as="geometry" />
        </mxCell>
